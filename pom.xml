<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.tradingjournal</groupId>
    <artifactId>trading-journal-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>trading-journal-api</name>
    <description>Trading Journal API - Actividad 1</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Estadística/métricas (tasa de peticiones, errores, latencia p50/p95
             por endpoint) — expuestas en /actuator/prometheus para que
             cualquier herramienta SAAS (Grafana Cloud, etc.) las recoja. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Trazas distribuidas: Micrometer Tracing (la forma nativa de
             Spring Boot) puenteado a OpenTelemetry. El exportador queda en
             "logging" por defecto (las trazas se ven en los logs, sin
             depender de que el grupo ya haya elegido un backend) — se
             cambia a OTLP con una sola propiedad cuando el grupo defina
             la herramienta SAAS transversal. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <!-- Spring Boot 4 separó la auto-configuración de tracing (el Tracer,
             el SdkTracerProvider, el cableado de los SpanExporter) en este
             módulo aparte — sin él, micrometer-tracing-bridge-otel queda
             en el classpath pero inerte, no crea ningún bean de tracing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-logging</artifactId>
        </dependency>
        <!-- Ya queda instalado el exportador OTLP también, listo para
             apuntar a Grafana Cloud (o el que decida el grupo) con solo
             cambiar management.otlp.tracing.endpoint — sin otro despliegue. -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- Métricas por OTLP hacia Grafana Cloud (además de /actuator/prometheus,
             que sigue existiendo para scraping local). El equivalente Java del
             metricReader + OTLPMetricExporter que usa Pipe en su instrumentation.ts. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <!-- Logs por OTLP hacia Grafana Cloud (Loki, detrás del mismo gateway
             OTLP que ya usan trazas y métricas). Spring Boot 4.1 sí arma el
             SdkLoggerProvider + el exportador solo (spring-boot-opentelemetry),
             pero no conecta Logback a él — este appender es el puente; se
             instala a mano en OtelLogAppenderInitializer una vez el bean
             OpenTelemetry de Spring existe (ver esa clase para el porqué). -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>2.20.1-alpha</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>com.oracle.oci.sdk</groupId>
            <artifactId>oci-java-sdk-objectstorage</artifactId>
            <version>3.68.1</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.oci.sdk</groupId>
            <artifactId>oci-java-sdk-common</artifactId>
            <version>3.68.1</version>
        </dependency>
        <dependency>
            <groupId>com.oracle.oci.sdk</groupId>
            <artifactId>oci-java-sdk-common-httpclient-jersey3</artifactId>
            <version>3.68.1</version>
        </dependency>
        <!-- El SDK de OCI usa Jackson 2.x internamente (paquete com.fasterxml),
             distinto del Jackson 3.x (tools.jackson) que usa el resto del
             proyecto — coexisten en paquetes distintos, sin choque real, pero
             jackson-databind:2.x necesita jackson-core:2.x explícito porque
             nada más en el árbol de dependencias lo estaba trayendo. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.21.4</version>
        </dependency>

        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
