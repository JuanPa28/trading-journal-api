                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test(\"Se identifica (X-App-Name: pipe)\", () => pm.expect(pm.response.headers.get('X-App-Name') === 'pipe').to.eql(true));",
                  "pm.test(\"Devuelve el mismo X-Trace-Id\", () => pm.expect(pm.response.headers.get('X-Trace-Id') === pm.collectionVariables.get('traceId')).to.eql(true));"
                ]
              }
