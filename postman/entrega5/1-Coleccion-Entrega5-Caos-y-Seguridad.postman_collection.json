      ]
    },
    {
      "name": "4. Seguridad: un hueco declarado en el inventario",
      "description": "Esta petición documenta un riesgo residual que está declarado en el inventario de controles: el endpoint de métricas es público.",
      "item": [
        {
          "name": "4.1 /actuator/prometheus es público (riesgo residual declarado)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/prometheus",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "prometheus"
              ]
            },
            "description": "Cualquiera puede leer las métricas del coordinador. No expone datos de negocio, pero es una superficie que está declarada como riesgo residual (carga de trabajo, 'hueco menor'). La mejora sería ponerlo detrás de autenticación o de una red privada."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200: el endpoint está expuesto (hueco declarado)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
