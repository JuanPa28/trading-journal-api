{
  "chaoslib-version": "1.45.1",
  "platform": "Linux-7.0.0-1016-aws-x86_64-with-glibc2.43",
  "node": "ip-10-0-142-34",
  "experiment": {
    "version": "1.0.0",
    "title": "Latencia saliente del coordinador hacia Mari",
    "description": "Dado el perfil de carga fijo (caos/carga/perfil.js), cuando se inyecten 3000 ms de latencia en las llamadas del coordinador hacia la API de Mari durante 3 minutos, el flujo mantendra una tasa de exito >= 99 % y un p95 extremo a extremo <= 1600 ms (estado estable medido el 13 de noviembre: caos/resultados/estado-estable.md).",
    "tags": [
      "devops",
      "latencia",
      "juan",
      "azure"
    ],
    "configuration": {
      "coordinador": {
        "type": "env",
        "key": "BASE_URL",
        "default": "https://api-coordinador.jollybeach-fbb8b9ad.eastus.azurecontainerapps.io"
      },
      "trade_id": {
        "type": "env",
        "key": "TRADE_ID",
        "default": "5540"
      },
      "latencia_ms": {
        "type": "env",
        "key": "FAULT_LATENCY_MS",
        "default": "3000"
      },
      "objetivo": {
        "type": "env",
        "key": "FAULT_TARGET",
        "default": "mari"
      },
      "p95_ms": {
        "type": "env",
        "key": "P95_MS",
        "default": "1600"
      },
      "resumen": {
        "type": "env",
        "key": "RESUMEN_K6",
        "default": "caos/resultados/gate-resumen.json"
      }
    },
    "steady-state-hypothesis": {
      "title": "El coordinador esta sano antes y despues del experimento",
      "probes": [
        {
          "type": "probe",
          "name": "salud-del-coordinador",
          "tolerance": 200,
          "provider": {
            "type": "http",
            "url": "${coordinador}/actuator/health",
            "timeout": 30
          }
        }
      ]
    },
    "method": [
      {
        "type": "action",
        "name": "inyectar-latencia-saliente-y-correr-el-perfil-de-carga",
        "provider": {
          "type": "process",
          "path": "k6",
          "arguments": "run -q -e BASE_URL=${coordinador} -e TRADE_ID=${trade_id} -e FAULT_LATENCY_MS=${latencia_ms} -e FAULT_TARGET=${objetivo} -e P95_MS=${p95_ms} --summary-export ${resumen} caos/carga/perfil.js",
          "timeout": 600
        }
      }
    ],
    "rollbacks": [
      {
        "type": "action",
        "name": "verificar-la-reversion",
        "provider": {
          "type": "http",
          "url": "${coordinador}/api/v2/trades/${trade_id}",
          "timeout": 30
        }
      }
    ],
    "extensions": [
      {
        "name": "metadatos-del-experimento",
        "responsable": "Juan",
        "metrica_objetivo": "latencia p95 extremo a extremo (k6) y tasa de exito del flujo",
        "metodo_de_inyeccion": "cabecera X-Inject-Outbound-Latency-Ms en cada peticion de k6; el coordinador espera ese tiempo antes de llamar a Mari (requiere FAULT_HEADER_ENABLED=true)",
        "radio_de_impacto": "solo las peticiones de k6 que llevan la cabecera; las llamadas del coordinador hacia Mari; el resto del trafico no se afecta; datos sinteticos",
        "duracion_minutos": 3,
        "condiciones_de_aborto": [
          "tasa de exito del flujo < 50 % (k6 detiene la prueba tras 20 s)",
          "p95 > 15000 ms (k6 detiene la prueba tras 20 s)"
        ],
        "interruptor_de_parada": "quitar la cabecera o poner FAULT_HEADER_ENABLED=false en el coordinador",
        "plan_de_reversion": "la falla vive solo en las peticiones con cabecera: al terminar la prueba se revierte sola; el rollback verifica que el flujo responde 200 sin la cabecera",
        "evaluacion": "python caos/gate/evaluar.py --resumen ${resumen} --p95-max 1600 --exito-min 99",
        "ronda": 0
      }
    ],
    "dry": null
  },
